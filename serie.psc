Algoritmo serie 
	Definir conN, canT, termino Como Entero
	Imprimir " ingrese la cantidad de terminos a generar"
	Leer canT
	conN = 0
	termino = 1 
	Repetir 
		Imprimir  termino "," 
		termino = termino+ 2 
		conN = conN + 1 
	Mientras Que ( conN < canT - 1 )
	 Imprimir termino 
		
	
FinAlgoritmo
